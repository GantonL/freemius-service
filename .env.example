# Server
PORT=8000

# Freemius API credentials
# Find these in your Freemius Developer Dashboard
FREEMIUS_STORE_ID=
FREEMIUS_PRODUCT_ID=
FREEMIUS_API_TOKEN=
FREEMIUS_PRODUCT_SECRET=

# Optional: Database persistence (Mikro-ORM + PostgreSQL)
# If empty, database persistence will be disabled
DATABASE_URL=postgres://user:password@localhost:5432/freemius_service

# Optional: Forward verified webhook events to your app
# Leave empty to disable forwarding
WEBHOOK_FORWARD_URL=
WEBHOOK_FORWARD_SECRET=
