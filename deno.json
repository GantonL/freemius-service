{
  "tasks": {
    "dev": "deno run --watch --allow-net --allow-env --env --allow-read src/main.ts",
    "start": "deno run --allow-net --allow-env --allow-read src/main.ts",
    "test": "deno test --allow-net --allow-env --allow-read"
  },
  "compilerOptions": {
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true
  },
  "nodeModulesDir": "auto",
  "imports": {
    "@danet/core": "jsr:@danet/core@^2.9.6",
"@std/assert": "jsr:@std/assert@^1.0.19",
    "drizzle-orm": "npm:drizzle-orm@^0.30.10",
    "postgres": "npm:postgres@^3.4.4",
    "drizzle-kit": "npm:drizzle-kit@^0.21.4"
  },
  "lint": {
    "rules": {
      "exclude": ["require-await"]
    }
  }
}
